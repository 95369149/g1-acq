#!name=G1 ACQ v3
#!desc=Google One 订阅页商品 ID 映射 v3：Pro 5TB 18/15/12 个月 $0 免费试用（默认 18 个月）、Ultra 20TB/30TB 1 个月免费试用，Safari 控制台一键切换目标 SKU。Surge / Loon。基于 Dgkncn/g1-acq-plus v8.0.0，原作者 crhywun/g1-acq。
#!openUrl=https://github.com/95369149/g1-acq
#!author=crhywun (v3 by Muse, based on Dgkncn v8.0.0)
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
http-response ^https:\/\/one\.google\.com\/ requires-body=true, script-path=https://cdn.jsdelivr.net/gh/95369149/g1-acq@main/g1-acq-v3.js, timeout=10, tag=g1-acq-v3
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/95369149/g1-acq@main/g1-sku-report-v3.js, timeout=10, tag=g1-sku-report-v3

[MITM]
hostname = one.google.com
